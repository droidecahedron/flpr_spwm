/* Same doorbells as nRF54L15, see nrf54l15dk_nrf54l15_cpuapp.overlay */
/ {
	doorbells {
		compatible = "flpr-spwm-doorbells";
		mboxes = <&cpuapp_vevif_rx 20>, <&cpuapp_vevif_tx 16>;
		mbox-names = "rx", "tx";
	};
};

&cpuapp_vevif_rx {
	status = "okay";
};

&cpuapp_vevif_tx {
	status = "okay";
};

/* Load marker, high while the app compiles and loads a pattern. P1.03 is only on
 * the expansion-header gpio-map, no board device claims it.
 */
/ {
	zephyr,user {
		marker-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
	};
};

/* P2.01/P2.02 are the only VIO0/VIO1 pins and the DK routes them to the external flash.
 * The FLPR takes them, so the flash has to go. Board Configurator moves them to the P2 header.
 */
&spi00 {
	status = "disabled";
};

&mx25r64 {
	status = "disabled";
};

/* Control block + pattern buffers, top 32 KB of the nordic-flpr region. The FLPR image is
 * linked into the bottom 64 KB (remote overlay). The snippet's reserved node still covers
 * all 96 KB, so the app never links anything here.
 * nordic_vpr_launcher copies all 96 KB from RRAM at boot, so the app fills it after that.
 */
/ {
	soc {
		spwm_shm: memory@20077c00 {
			reg = <0x20077c00 DT_SIZE_K(32)>;
			status = "reserved";
		};
	};
};
