/* VEVIF doorbells. The app rings FLPR task 16 (START), and the FLPR answers on
 * event 20 (DONE), the only FLPR->app event Zephyr's vevif event-rx accepts on 54L.
 */
/ {
	doorbells {
		compatible = "flpr-spwm-doorbells";
		mboxes = <&cpuapp_vevif_rx 20>, <&cpuapp_vevif_tx 16>;
		mbox-names = "rx", "tx";
	};
};

/* nordic-flpr only enables the tx side */
&cpuapp_vevif_rx {
	status = "okay";
};

&cpuapp_vevif_tx {
	status = "okay";
};

/* Load marker, high while the app compiles and loads a pattern. P1.11 is only on
 * the expansion-header gpio-map, no board device claims it.
 */
/ {
	zephyr,user {
		marker-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
	};
};

/* P2.01/P2.02 are the only VIO0/VIO1 pins and the DK routes them to the external flash.
 * The FLPR takes them, so the flash has to go. Board Configurator moves them to the P2 header.
 */
&spi00 {
	status = "disabled";
};

&mx25r64 {
	status = "disabled";
};
