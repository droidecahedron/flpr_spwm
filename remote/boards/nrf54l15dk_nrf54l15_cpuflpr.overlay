/* Mirror of the app overlay: START arrives on task 16, DONE leaves on event 20 */
/ {
	doorbells {
		compatible = "flpr-spwm-doorbells";
		mboxes = <&cpuflpr_vevif_rx 16>, <&cpuflpr_vevif_tx 20>;
		mbox-names = "rx", "tx";
	};
};

&cpuflpr_vevif_rx {
	status = "okay";
};

&cpuflpr_vevif_tx {
	status = "okay";
};

/* Stock cpuflpr console. Its pins are P0.00-P0.03, which the DK routes to a VCOM. */
&uart30 {
	status = "disabled";
};

/* Legs A/B. VIO0 = P2.01 and VIO1 = P2.02 on nRF54L15 and nRF54LM20. The FLPR hands them to
 * itself with CTRLSEL = VPR before it drives them.
 */
/ {
	zephyr,user {
		leg-gpios = <&gpio2 1 GPIO_ACTIVE_HIGH>, <&gpio2 2 GPIO_ACTIVE_HIGH>;
	};
};
